# Public UI settings: never place tokens in VITE_* variables.
VITE_PROFILE=local
VITE_BASE_PATH=/
# Local server and installed-model discovery; fill the served ID after probing.
APP_BIND_HOST=127.0.0.1
APP_BIND_PORT=8000
APP_DATABASE_PATH=runtime/oncogrowth.sqlite3
APP_QWEN_BASE_URL=
APP_QWEN_MODEL_ID=
APP_QWEN_API_KEY=
APP_QWEN_MAX_OUTPUT_TOKENS=512
APP_QWEN_TIMEOUT_SECONDS=20
APP_JOB_QUEUE_CAPACITY=16
APP_GPU_WORKERS=1
APP_BREAKER_FAILURE_THRESHOLD=3
APP_BREAKER_COOLDOWN_SECONDS=30
APP_CACHE_MAX_MB=256
APP_EXPLANATION_CACHE_TTL_SECONDS=3600
APP_SEED=7
APP_RELEASE_INDEX_PATH=artifacts/public/release-index.json
APP_IO_WORKERS=2
APP_JOB_LEASE_SECONDS=30
# Example limits are validated startup defaults, not hardware measurements.
# Pages build overrides profile/base path and contains no server values.
