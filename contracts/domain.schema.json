{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oncogrowth:domain:1",
  "title": "OncoGrowth domain v1",
  "$comment": "Cross-field scientific/job invariants in docs/CONTRACTS.md require semantic validators in addition to this schema.",
  "$defs": {
    "Problem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INVALID_INPUT",
            "NOT_FOUND",
            "QUEUE_FULL",
            "MODEL_UNAVAILABLE",
            "OUT_OF_DOMAIN",
            "DEPENDENCY_TIMEOUT",
            "INTERRUPTED",
            "INTERNAL"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "trace_id"
      ]
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "dataset_version": {
          "type": "string",
          "minLength": 1
        },
        "measurement_method": {
          "type": "string",
          "minLength": 1
        },
        "regimen_verified": {
          "type": "boolean"
        },
        "synthetic": {
          "type": "boolean"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "source_ref",
        "dataset_version",
        "measurement_method",
        "regimen_verified",
        "synthetic",
        "limitations"
      ]
    },
    "Observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "day": {
          "type": "number",
          "minimum": 0
        },
        "volume_cm3": {
          "type": "number",
          "minimum": 0
        },
        "measurement": {
          "type": "string",
          "enum": [
            "ftv",
            "mask_volume",
            "synthetic"
          ]
        },
        "phase": {
          "type": "string",
          "enum": [
            "baseline",
            "early_paclitaxel"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "day",
        "volume_cm3",
        "measurement",
        "phase",
        "source_ref"
      ]
    },
    "CaseRecord": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "cancer": {
          "const": "breast"
        },
        "source": {
          "type": "string",
          "enum": [
            "ispy2",
            "synthetic"
          ]
        },
        "patient_group_id": {
          "type": "string",
          "minLength": 1
        },
        "baseline_volume_cm3": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "subtype": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Observation"
          }
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "eligible_paclitaxel": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label",
        "cancer",
        "source",
        "patient_group_id",
        "baseline_volume_cm3",
        "subtype",
        "observations",
        "provenance",
        "eligible_paclitaxel"
      ]
    },
    "ScenarioRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": 1
        },
        "case_id": {
          "type": "string",
          "format": "uuid"
        },
        "engine": {
          "type": "string",
          "enum": [
            "empirical",
            "mechanistic"
          ]
        },
        "horizon_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 84
        },
        "intervention": {
          "type": "string",
          "enum": [
            "paclitaxel",
            "none"
          ]
        },
        "sensitivity_scale": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "contract_version",
        "case_id",
        "engine",
        "horizon_days",
        "intervention",
        "sensitivity_scale",
        "model_version",
        "seed"
      ]
    },
    "CurvePoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "day": {
          "type": "number",
          "minimum": 0
        },
        "volume_cm3": {
          "type": "number",
          "minimum": 0
        },
        "lower_cm3": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "upper_cm3": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "day",
        "volume_cm3",
        "lower_cm3",
        "upper_cm3"
      ]
    },
    "Curve": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "enum": [
            "forecast",
            "illustrative"
          ]
        },
        "band_kind": {
          "type": "string",
          "enum": [
            "none",
            "sensitivity",
            "empirical_interval"
          ]
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CurvePoint"
          }
        }
      },
      "required": [
        "label",
        "evidence",
        "band_kind",
        "points"
      ]
    },
    "ScenarioResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "request": {
          "$ref": "#/$defs/ScenarioRequest"
        },
        "source": {
          "type": "string",
          "enum": [
            "trained_model",
            "conditional_calibration",
            "mechanistic",
            "cached",
            "synthetic"
          ]
        },
        "origin_source": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "trained_model",
                "conditional_calibration",
                "mechanistic",
                "synthetic"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "curves": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Curve"
          },
          "minItems": 1,
          "maxItems": 1,
          "description": "Exactly one curve, for the requested intervention; a drug-on vs drug-off comparison is two requests (C31)."
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "request",
        "source",
        "origin_source",
        "curves",
        "model_version",
        "assumptions",
        "warnings",
        "provenance",
        "created_at"
      ]
    },
    "JobRecord": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "type": "string",
          "enum": [
            "scenario",
            "explanation"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "result_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "kind=scenario: ScenarioResult.id. kind=explanation: ExplanationResult.id."
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/Problem"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "kind",
        "state",
        "progress",
        "result_id",
        "error",
        "created_at",
        "updated_at"
      ]
    },
    "ExplanationRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "result_id": {
          "type": "string",
          "format": "uuid"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "result_id",
        "question"
      ]
    },
    "ExplanationResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "result_id": {
          "type": "string",
          "format": "uuid"
        },
        "source": {
          "type": "string",
          "enum": [
            "qwen",
            "cached_qwen",
            "template"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "referenced_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "result_id",
        "source",
        "text",
        "referenced_fields",
        "model_id",
        "warnings"
      ]
    },
    "Capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "type": "string",
          "enum": [
            "local",
            "pages"
          ]
        },
        "empirical_available": {
          "type": "boolean"
        },
        "mechanistic_available": {
          "type": "boolean"
        },
        "chat_available": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "ready",
            "degraded",
            "starting"
          ]
        },
        "empirical_model_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "mechanistic_model_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "degraded_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "profile",
        "empirical_available",
        "mechanistic_available",
        "chat_available",
        "status",
        "empirical_model_version",
        "mechanistic_model_version",
        "degraded_reasons"
      ]
    },
    "EmpiricalManifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "onnx_path": {
          "type": "string",
          "minLength": 1
        },
        "onnx_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "model_card_path": {
          "type": "string",
          "minLength": 1
        },
        "dtype": {
          "const": "float32"
        },
        "parity_tolerance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "engine": {
          "const": "empirical"
        },
        "preprocessing_path": {
          "type": "string",
          "minLength": 1
        },
        "preprocessing_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "inputs": {
          "const": [
            {
              "name": "baseline_volume_cm3",
              "shape": [
                "batch",
                1
              ]
            },
            {
              "name": "elapsed_days",
              "shape": [
                "batch",
                1
              ]
            }
          ]
        },
        "outputs": {
          "const": [
            {
              "name": "log_volume_ratio",
              "shape": [
                "batch",
                1
              ]
            },
            {
              "name": "volume_cm3",
              "shape": [
                "batch",
                1
              ]
            }
          ]
        },
        "volume_epsilon_cm3": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "validated_horizon_days": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cancer": {
          "const": "breast"
        },
        "intervention": {
          "const": "paclitaxel"
        },
        "trained_on": {
          "type": "string",
          "enum": [
            "real",
            "synthetic"
          ]
        },
        "band_kind": {
          "const": "none"
        },
        "train_patients": {
          "type": "integer",
          "minimum": 0
        },
        "validation_patients": {
          "type": "integer",
          "minimum": 0
        },
        "test_patients": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "band_kind",
        "cancer",
        "contract_version",
        "dtype",
        "engine",
        "inputs",
        "intervention",
        "limits",
        "model_card_path",
        "model_version",
        "onnx_path",
        "onnx_sha256",
        "outputs",
        "parity_tolerance",
        "preprocessing_path",
        "preprocessing_sha256",
        "test_patients",
        "train_patients",
        "trained_on",
        "validated_horizon_days",
        "validation_patients",
        "volume_epsilon_cm3"
      ]
    },
    "MechanisticManifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "onnx_path": {
          "type": "string",
          "minLength": 1
        },
        "onnx_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "model_card_path": {
          "type": "string",
          "minLength": 1
        },
        "dtype": {
          "const": "float32"
        },
        "parity_tolerance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "engine": {
          "const": "mechanistic"
        },
        "inputs": {
          "const": [
            {
              "name": "baseline_volume_cm3",
              "shape": [
                1
              ]
            },
            {
              "name": "days",
              "shape": [
                "T"
              ]
            },
            {
              "name": "intervention_on",
              "shape": [
                1
              ]
            },
            {
              "name": "sensitivity_scale",
              "shape": [
                1
              ]
            }
          ]
        },
        "outputs": {
          "const": [
            {
              "name": "volume_cm3",
              "shape": [
                "T"
              ]
            },
            {
              "name": "lower_cm3",
              "shape": [
                "T"
              ]
            },
            {
              "name": "upper_cm3",
              "shape": [
                "T"
              ]
            }
          ]
        },
        "max_horizon_days": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 84
        },
        "parameter_basis": {
          "type": "string",
          "enum": [
            "assumption",
            "conditional_calibration"
          ]
        },
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "band_kind": {
          "const": "sensitivity"
        }
      },
      "required": [
        "assumptions",
        "band_kind",
        "contract_version",
        "dtype",
        "engine",
        "inputs",
        "limits",
        "max_horizon_days",
        "model_card_path",
        "model_version",
        "onnx_path",
        "onnx_sha256",
        "outputs",
        "parameter_basis",
        "parity_tolerance"
      ]
    }
  }
}
